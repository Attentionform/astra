{
  "name": "astra",
  "version": "0.1.0",
  "private": true,
  "description": "ASTra - OOXML document engine, command-line tool and MCP server",
  "author": {
    "name": "Attentionform",
    "email": "astra@attentionform.com",
    "url": "https://attentionform.com"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@attentionform/ooxml-validator && npm run --workspaces --if-present build",
    "gen:schemas": "npx tsx scripts/generate_mcp_schemas.ts schemas/mcp",
    "test": "vitest run",
    "validate:docs": "npx tsx scripts/validate_docs.ts",
    "lint:docs": "npx tsx scripts/lint-docs.ts",
    "cla:sign": "npx tsx scripts/cla/sign.ts",
    "lint": "eslint .",
    "build": "npm run build:packages"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/pdf-parse": "^1.1.5",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "cheerio": "^1.2.0",
    "isomorphic-git": "^1.25.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^3.1.0",
    "pdf-parse": "^2.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "body-parser": "^2.3.1",
    "cheerio": {
      "undici": "7.30.1"
    },
    "dompurify": "3.4.17",
    "fast-uri": "^3.1.9",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "^4.3.2",
    "undici": "6.29.1"
  },
  "license": "BUSL-1.1",
  "homepage": "https://attentionform.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attentionform/astra.git"
  },
  "bugs": {
    "url": "https://github.com/Attentionform/astra/issues"
  }
}
