{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "astra": {
      "type": "local",
      "command": [
        "node",
        "./packages/mcp-server/dist/index.js",
        "--allowed-dir",
        "/absolute/path/to/your/documents"
      ],
      "environment": {
        "NODE_ENV": "production"
      },
      "enabled": true
    },
    "astra-dev": {
      "type": "local",
      "command": [
        "npx",
        "tsx",
        "./packages/mcp-server/src/index.ts",
        "--allowed-dir",
        "/absolute/path/to/your/documents"
      ],
      "environment": {
        "NODE_ENV": "development"
      },
      "enabled": false
    }
  }
}
