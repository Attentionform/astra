{
  "name": "@attentionform/astra",
  "version": "0.1.0",
  "description": "Command-line tool for OOXML (.docx) document engineering",
  "main": "dist/cli.js",
  "types": "dist/packages/cli/src/cli.d.ts",
  "bin": {
    "astra": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!dist/packages/engine",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attentionform/astra.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "astra",
    "ooxml",
    "docx",
    "word",
    "terminal",
    "document",
    "automation"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "node ../../scripts/check-adm-zip-imports.mjs && tsc --noEmit -p tsconfig.json && esbuild src/cli.ts --bundle --packages=external --platform=node --target=node22 --format=cjs --outfile=dist/cli.js --log-level=warning && tsc -p tsconfig.dts.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "adm-zip-gate": "node ../../scripts/check-adm-zip-imports.mjs"
  },
  "dependencies": {
    "@attentionform/astra-engine": "^0.1.0",
    "@attentionform/ooxml-validator": "^0.1.0",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "isomorphic-git": "^1.25.0",
    "marked": "18.0.5",
    "p-limit": "^3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://attentionform.com",
  "bugs": {
    "url": "https://github.com/Attentionform/astra/issues"
  },
  "author": {
    "name": "Attentionform",
    "url": "https://attentionform.com"
  }
}
