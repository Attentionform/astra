{
  "name": "@attentionform/astra-mcp-server",
  "version": "0.1.0",
  "description": "Official Model Context Protocol (MCP) server for ASTra document IDE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "astra-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Attentionform/astra.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "astra",
    "ooxml",
    "docx",
    "word",
    "ai-agent"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "node ../../scripts/check-adm-zip-imports.mjs && tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --packages=external --platform=node --target=node20 --format=cjs --outfile=dist/index.js --log-level=warning && tsc -p tsconfig.dts.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "adm-zip-gate": "node ../../scripts/check-adm-zip-imports.mjs"
  },
  "dependencies": {
    "@attentionform/astra-engine": "^0.1.0",
    "@attentionform/ooxml-validator": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "isomorphic-git": "^1.25.0",
    "marked": "18.0.5",
    "p-limit": "^3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.2.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "homepage": "https://attentionform.com",
  "bugs": {
    "url": "https://github.com/Attentionform/astra/issues"
  },
  "author": {
    "name": "Attentionform",
    "url": "https://attentionform.com"
  }
}
